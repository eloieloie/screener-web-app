# Environment variables for local development
# Copy this file to .env and fill in your actual values

# Zerodha KiteConnect API credentials
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Optional: unattended daily login (see server/kiteAutoLogin.js).
# Leave unset to keep using the manual "Login to Zerodha Kite" button only.
# KITE_USER_ID is your Zerodha client ID (e.g. AB1234).
# KITE_TOTP_SECRET is the base32 secret shown when you set up TOTP 2FA on
# Kite (the same secret you'd scan into an authenticator app) — NOT a one-time
# code. If you didn't save it during setup, reset your 2FA method on Kite to
# get a fresh secret.
# KITE_USER_ID=your_zerodha_client_id
# KITE_PASSWORD=your_zerodha_password
# KITE_TOTP_SECRET=your_totp_base32_secret

# Session secret for local development
SESSION_SECRET=your-super-secret-session-key-here

# Server port (optional, defaults to 3001)
PORT=3001